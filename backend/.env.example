# Radiology STT Pipeline Configuration

# Gemini API Key (Required for Gemini Live STT)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI API Key (Required for GPT Realtime STT)
# Get your key at: https://platform.openai.com/
OPENAI_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Default AI Model: "gemini" | "openai" | "mock"
DEFAULT_MODEL=gemini

# WebRTC VAD Aggressiveness: 0 (gentlest) to 3 (most aggressive)
# Mode 2 or 3 is recommended for radiology dictation in rooms with background hum/typing
VAD_MODE=2

# VAD Hangover buffer in frames (10ms each, e.g., 30 frames = 300ms)
VAD_HANGOVER_FRAMES=30
